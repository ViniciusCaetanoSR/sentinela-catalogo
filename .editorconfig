# Convenções de editor. O resto do estilo fica com o ruff (pyproject.toml).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Dois espaços no fim da linha são quebra de linha em Markdown.
trim_trailing_whitespace = false
